GridView displays Students data with Edit, Delete buttons, and supports paging(more than 
5 records display in next page) and sorting (ID, Name, Age). 



Program 12: Implement XML Classes 
Use XmlDocument to read and XmlTextWriter to write XML. 
Program12.aspx: 
<%@ Page Language="C#" AutoEventWireup="true" CodeFile="Program12.aspx.cs" 
Inherits="Program12" %> 
<!DOCTYPE html> 
<html xmlns="http://www.w3.org/1999/xhtml"> 
<head runat="server"> 
<title>Program 12</title> 
</head> 
<body> 
<form id="form1" runat="server"> 
<div> 
<asp:Button ID="btnRead" runat="server" Text="Read XML" 
OnClick="btnRead_Click" /><br /><br /> 
<asp:GridView ID="GridView1" runat="server" 
AutoGenerateColumns="True"></asp:GridView><br /><br /> 
ID: <asp:TextBox ID="txtID12" runat="server"></asp:TextBox><br 
/><br /> 
Name: <asp:TextBox ID="txtName12" 
runat="server"></asp:TextBox><br /><br /> 
Age: <asp:TextBox ID="txtAge12" 
runat="server"></asp:TextBox><br /><br /> 
<asp:Button ID="btnWrite" runat="server" Text="Write XML" 
OnClick="btnWrite_Click" /><br /><br /> 
<asp:Label ID="lblStatus12" runat="server"></asp:Label> 
</div> 
</form> 
</body> 
</html> 
Program12.aspx.cs: 
using System; 
using System.Data; 
using System.Xml; 
public partial class Program12 : System.Web.UI.Page 
{ 
protected void btnRead_Click(object sender, EventArgs e) 
{ 
XmlDocument xmlDoc = new XmlDocument(); 
xmlDoc.Load(Server.MapPath("~/App_Data/NewStudents.xml")); 
XmlNodeList nodes = xmlDoc.SelectNodes("/Students/Student"); 
DataTable dt = new DataTable(); 
dt.Columns.Add("StudentID"); 
dt.Columns.Add("Name"); 
dt.Columns.Add("Age"); 
foreach (XmlNode node in nodes) 
{ 
} 
DataRow dr = dt.NewRow(); 
dr["StudentID"] = node["StudentID"].InnerText; 
dr["Name"] = node["Name"].InnerText; 
dr["Age"] = node["Age"].InnerText; 
dt.Rows.Add(dr); 
GridView1.DataSource = dt; 
GridView1.DataBind(); 
} 
protected void btnWrite_Click(object sender, EventArgs e) 
{ 
string filePath = Server.MapPath("~/App_Data/NewStudents.xml"); 
XmlDocument xmlDoc = new XmlDocument(); 
// If file exists, load and append 
if (System.IO.File.Exists(filePath)) 
{ 
xmlDoc.Load(filePath); 
XmlNode root = xmlDoc.DocumentElement; 
XmlElement student = xmlDoc.CreateElement("Student"); 
XmlElement id = xmlDoc.CreateElement("StudentID"); 
id.InnerText = txtID12.Text; 
student.AppendChild(id); 
XmlElement name = xmlDoc.CreateElement("Name"); 
name.InnerText = txtName12.Text; 
student.AppendChild(name); 
XmlElement age = xmlDoc.CreateElement("Age"); 
age.InnerText = txtAge12.Text; 
student.AppendChild(age); 
root.AppendChild(student); 
} 
else 
{ 
"UTF-8", null); 
// If file doesn't exist, create new structure 
XmlDeclaration xmlDecl = xmlDoc.CreateXmlDeclaration("1.0", 
xmlDoc.AppendChild(xmlDecl); 
XmlElement root = xmlDoc.CreateElement("Students"); 
xmlDoc.AppendChild(root); 
XmlElement student = xmlDoc.CreateElement("Student"); 
XmlElement id = xmlDoc.CreateElement("StudentID"); 
id.InnerText = txtID12.Text; 
student.AppendChild(id); 
XmlElement name = xmlDoc.CreateElement("Name"); 
name.InnerText = txtName12.Text; 
student.AppendChild(name); 
XmlElement age = xmlDoc.CreateElement("Age"); 
age.InnerText = txtAge12.Text; 
student.AppendChild(age); 
root.AppendChild(student); 
} 
xmlDoc.Save(filePath); 
lblStatus12.Text = "Student added to XML file."; 
} 
} 
Output: 
Enter ID, Name, Age and click Write XML to create NewStudents.xml and display success 
message. Click Read XML to populate GridView from Students.xml. 

Program 13: Implement Authentication–Authorization 
Demonstrate Forms Authentication with login and protected page. 
Program13.aspx: 
<%@ Page Language="C#" AutoEventWireup="true" CodeFile="Program13.aspx.cs" 
Inherits="Program13" %> 
<!DOCTYPE html> 
<html xmlns="http://www.w3.org/1999/xhtml"> 
<head runat="server"> 
<title>Login Page</title> 
</head> 
<body> 
<form id="form1" runat="server"> 
<div> 
<asp:TextBox ID="txtUser" runat="server" 
Placeholder="Username"></asp:TextBox><br /><br /> 
<asp:TextBox ID="txtPass" runat="server" TextMode="Password" 
Placeholder="Password"></asp:TextBox><br /><br /> 
<asp:Button ID="btnLogin" runat="server" Text="Login" 
OnClick="btnLogin_Click" /><br /><br /> 
<asp:Label ID="lblError" runat="server"></asp:Label> 
</div> 
</form> 
</body> 
</html> 
Program13.aspx.cs: 
using System; 
using System.Web.Security; 
public partial class Login : System.Web.UI.Page 
{ 
protected void btnLogin_Click(object sender, EventArgs e) 
{ 
if (txtUser.Text == "admin" && txtPass.Text == "admin") 
{ 
FormsAuthentication.RedirectFromLoginPage(txtUser.Text, false); 
Response.Redirect("Welcome.aspx");  
} 
else 
{ 
lblError.Text = "Invalid credentials."; 
} 
} 
} 
Welcome.aspx: 
<%@ Page Language="C#" AutoEventWireup="true" CodeFile="Welcome.aspx.cs" 
Inherits="Welcome" %> 
<!DOCTYPE html> 
<html xmlns="http://www.w3.org/1999/xhtml"> 
<head runat="server"> 
<title>Welcome</title> 
</head> 
<body> 
<form id="form1" runat="server"> 
<div> 
<h1> Welcome Admin </h1> 
</div> 
</form> 
</body> 
</html> 
Output: 
Program13.aspx authenticates user "admin"/"admin". On success, redirects to 
Protected.aspx showing "Welcome, admin". 


Program 14: Ticket Reservation Using ASP.NET Controls 
Create a form to select source, destination, date, and display ticket details. 
Program14.aspx: 
<%@ Page Language="C#" AutoEventWireup="true" CodeFile="Program14.aspx.cs" 
Inherits="Program14" %> 
<!DOCTYPE html> 
<html xmlns="http://www.w3.org/1999/xhtml"> 
<head runat="server"> 
<title>Ticket Reservation</title> 
</head> 
<body> 
<form id="form1" runat="server"> 
<div> 
Source: <asp:DropDownList ID="ddlSource" runat="server"> 
<asp:ListItem>City A</asp:ListItem> 
<asp:ListItem>City B</asp:ListItem> 
</asp:DropDownList><br /><br /> 
Destination: <asp:DropDownList ID="ddlDestination" 
runat="server"> 
<asp:ListItem>City X</asp:ListItem> 
<asp:ListItem>City Y</asp:ListItem> 
</asp:DropDownList><br /><br /> 
<asp:Calendar ID="Calendar1" runat="server"></asp:Calendar><br 
/><br /> 
<asp:Button ID="btnReserve" runat="server" Text="Reserve 
Ticket" OnClick="btnReserve_Click" /><br /><br /> 
<asp:Label ID="lblTicket" runat="server"></asp:Label> 
</div> 
</form> 
</body> 
</html> 
Program14.aspx.cs: 
using System; 
public partial class Program14 : System.Web.UI.Page 
{ 
protected void btnReserve_Click(object sender, EventArgs e) 
{ 
lblTicket.Text = "Ticket Reserved: From " + 
ddlSource.SelectedItem.Text + " to " + ddlDestination.SelectedItem.Text + 
"; Date: " + Calendar1.SelectedDate.ToShortDateString(); 
} 
} 
Output: 
Displays reservation details: source, destination, and selected date after clicking Reserve 
Ticket. 
 
 
  
Program 15: Online Examination Using ASP.NET Controls 
Create a quiz with multiple choice questions using RadioButtonList and display score. 
Program15.aspx: 
<%@ Page Language="C#" AutoEventWireup="true" CodeFile="Program15.aspx.cs" 
Inherits="Program15" %> 
<!DOCTYPE html> 
<html xmlns="http://www.w3.org/1999/xhtml"> 
<head runat="server"> 
<title>Online Examination</title> 
</head> 
<body> 
<form id="form1" runat="server"> 
<div> 
<h4>1. What is the capital of India?<br /></h4> 
<asp:RadioButtonList ID="rblQ1" runat="server"> 
<asp:ListItem>New Delhi</asp:ListItem> 
<asp:ListItem>Chennai</asp:ListItem> 
<asp:ListItem>Kerala</asp:ListItem> 
</asp:RadioButtonList><br /><br /> 
<h4>2. Select programming languages:<br /></h4> 
<asp:CheckBoxList ID="cblQ2" runat="server"> 
<asp:ListItem Text="C" Value="C#"></asp:ListItem> 
<asp:ListItem Text="HTML" Value="HTML"></asp:ListItem> 
<asp:ListItem Text="Java" Value="Java"></asp:ListItem> 
</asp:CheckBoxList><br /><br /> 
<asp:Button ID="btnSubmitExam" runat="server" Text="Submit Exam" 
OnClick="btnSubmitExam_Click" /><br /><br /> 
<asp:Label ID="lblScore" runat="server"></asp:Label> 
</div> 
</form> 
</body> 
</html> 
Program15.aspx.cs: 
using System; 
public partial class Program15 : System.Web.UI.Page 
{ 
protected void btnSubmitExam_Click(object sender, EventArgs e) 
{ 
+= 5; 
} 
} 
Output: 
int score = 0; 
if (rblQ1.SelectedValue == "New Delhi") score += 5; 
foreach (System.Web.UI.WebControls.ListItem li in cblQ2.Items) 
{ 
} 
if (li.Selected && (li.Value == "C" || li.Value == "Java")) score 
lblScore.Text = "Your Score: " + score; 
Displays score: 5 points for each correct answer (Q1 and Q2). 

 
 
 
 
 
